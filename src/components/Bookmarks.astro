---
import { formatBookmark } from '../lib/bookmarks';
---

<section class="bookmarks-panel" aria-labelledby="bookmarks-title">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">Your private link shelf</p>
      <h2 id="bookmarks-title">Keep the good stuff close</h2>
    </div>
    <span class="mark" aria-hidden="true">✦</span>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="example.com/article"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code>. Mona will tidy it up and make a short slug.</p>
  <p id="form-message" class="form-message" role="status" aria-live="polite"></p>

  <div id="list-header" hidden>
    <h3 class="list-title">Saved bookmarks</h3>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<style>
  .bookmarks-panel {
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: 1rem;
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent 55%);
    box-shadow: 0 1rem 3rem color-mix(in srgb, #000 14%, transparent);
  }
  .panel-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .eyebrow { margin: 0 0 0.25rem; color: var(--accent); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  h2 { margin: 0; font-family: var(--font-head); font-size: 1.35rem; }
  .mark { color: var(--accent); font-size: 1.6rem; line-height: 1; }
  form { margin-top: 1.25rem; }
  button { white-space: nowrap; }
  .hint { margin-bottom: 0.75rem; }
  .form-message { min-height: 1.25rem; margin: 0 0 0.5rem; color: #d97706; font-size: 0.8rem; }
  .form-message:empty { display: none; }
  #list-header { margin-top: 1.5rem; }
  .empty { background: color-mix(in srgb, currentColor 3%, transparent); }
  li.bookmark { background: color-mix(in srgb, currentColor 3%, transparent); }
  .bookmark .url { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 0.2em; }
  .bookmark .url:hover { color: var(--accent); }
  .bookmark .slug { font-family: var(--font-body); font-weight: 600; }
</style>

<script>
  import {
    createSlug,
    formatBookmark,
    loadBookmarks,
    normalizeUrl,
    type Bookmark,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const message = document.getElementById('form-message');
  const clearButton = document.getElementById('clear-all');

  let bookmarks: Bookmark[] = [];

  function readStorage(): Bookmark[] {
    try {
      return loadBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function writeStorage() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      if (message) message.textContent = 'This browser could not save the bookmark.';
    }
  }

  function nextSlug(): string {
    const used = new Set(bookmarks.map((bookmark) => bookmark.slug));
    let slug = createSlug(Date.now() + Math.floor(Math.random() * 62 ** 3));
    while (used.has(slug)) slug = createSlug(Date.now() + Math.floor(Math.random() * 62 ** 4));
    return slug;
  }

  function render() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    bookmarks.forEach((bookmark, index) => {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer noopener';
      link.textContent = bookmark.url;
      link.title = formatBookmark(bookmark);

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
        }
      });

      const text = document.createElement('span');
      text.className = 'bookmark-text';
      text.append(link, document.createTextNode(' :: '), slug);
      item.append(text, copy);
      item.dataset.index = String(index);
      list.append(item);
    });
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!input || !message) return;
    const url = normalizeUrl(input.value);
    if (!url) {
      message.textContent = 'Enter a valid web address to save.';
      input.focus();
      return;
    }

    bookmarks = [...bookmarks, { url, slug: nextSlug() }];
    writeStorage();
    input.value = '';
    message.textContent = '';
    render();
  });

  clearButton?.addEventListener('click', () => {
    if (!bookmarks.length || !window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    writeStorage();
    render();
  });

  bookmarks = readStorage();
  render();
</script>
